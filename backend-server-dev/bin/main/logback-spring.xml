<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Use Spring Boot defaults -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Console appender with colors -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %highlight(%-5level) %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File appender with rotation -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>boot.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Roll daily -->
            <fileNamePattern>boot-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- Each file max 10MB -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Keep 7 days of history -->
            <maxHistory>7</maxHistory>
            <!-- Total size cap 100MB -->
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    
    <!-- Application-specific logging -->
    <logger name="com.marketmono" level="DEBUG"/>
    
    <!-- Suppress noisy loggers in local/dev -->
    <springProfile name="local,dev">
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
        <logger name="org.hibernate.orm" level="WARN"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.apache.coyote" level="WARN"/>
        <logger name="org.apache.tomcat" level="WARN"/>
    </springProfile>
    
    <!-- Production logging -->
    <springProfile name="prod">
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework.web" level="INFO"/>
    </springProfile>
</configuration>
