# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# Frontend Application URL (your domain or localhost)
VITE_APP_URL=http://localhost:5173

# Backend API URL (where your backend is running)
VITE_BASE_URL=http://localhost:3001

# Google OAuth Client ID (get from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Enable cookie-based authentication (true/false)
VITE_COOKIE_BASED_AUTHENTICATION=false
