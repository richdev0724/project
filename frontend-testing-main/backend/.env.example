# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ======================
# API Keys
# ======================

# Polygon.io API Key (for market data, options data, stock prices)
# Get from: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your-polygon-api-key-here

# Financial Modeling Prep API Key (for company profiles, financials)
# Get from: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your-fmp-api-key-here

# Benzinga API Key (for logos and company data)
# Get from: https://www.benzinga.com/apis
BENZINGA_API_KEY=your-benzinga-api-key-here

# Marketaux API Token (for news data)
# Get from: https://www.marketaux.com/
MARKETAUX_API_TOKEN=your-marketaux-api-token-here

# ======================
# ClickHouse Database Configuration
# ======================

# ClickHouse database URL
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse username
CLICKHOUSE_USER=default

# ClickHouse password
CLICKHOUSE_PASSWORD=

# ClickHouse database name
CLICKHOUSE_DATABASE=options

# ======================
# Server Configuration
# ======================

# Port for backend server (default: 3001)
PORT=3001

# Allowed CORS origins (comma-separated list)
# Example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Node environment (development/production)
NODE_ENV=development
