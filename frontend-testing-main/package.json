{
  "name": "market-mono-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "node init && vite",
    "dev": "node init && vite",
    "build": "node init && tsc && vite build",
    "lint:fix": "eslint . --ext ts,tsx --fix && prettier --write .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "validate-branch": "validate-branch-name",
    "release": "commit-and-tag-version"
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "npm run lint:fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
